# Copie para .env nesta mesma pasta e preencha. NUNCA commite o .env de verdade.
# Este script vai rodar direto no INVESTSEGN (mesma máquina da pasta), então o
# caminho é local — não precisa de usuário/senha de rede.

PASTA_PROPOSTAS=C:\Propostas

# Mesma URL do Supabase que já está no index.html do CRM.
SUPABASE_URL=https://gzzpcorctunadifxweea.supabase.co

# Painel do Supabase > Project Settings > API > service_role key.
# Essa chave ignora o RLS — é o que permite o script escrever sem estar logado
# como um usuário. Diferente da anon key (que está no index.html e pode ficar
# pública), essa NUNCA pode ir para o GitHub.
SUPABASE_SERVICE_KEY=

# Só preencha os dois abaixo se um dia mover o script pra rodar em OUTRO PC
# (lendo a pasta por rede em vez de local). Rodando aqui no INVESTSEGN, deixe em branco.
REDE_USUARIO=
REDE_SENHA=
